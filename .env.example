# Copy to .env for local execution. Never commit .env.
# Placeholders only - replace values for real runs.

# --- Celesto sandbox execution ---
# mock: local deterministic adapter + host Playwright browser (no cloud).
# live: real Celesto Cloud sandboxes via the REST API (needs CELESTO_API_KEY
#       and account credit; the platform CDP gateway needs a non-trial size,
#       while the in-guest Playwright fallback also works on Micro).
CELESTO_MODE=mock
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_API_URL=https://api.celesto.ai
CELESTO_TEMPLATE_ID=browser-agent
CELESTO_SIZE_ID=standard
CELESTO_IMAGE=ubuntu-desktop-24.04
CELESTO_STARTUP_TIMEOUT_S=240
# How long a live create may keep waiting out cloud creation-quota
# throttles (429) before failing. Quota waits happen outside timed eval runs.
CELESTO_CREATE_PATIENCE_S=1800
# Provider ids of deliberately retained sandboxes (comma-separated) that the
# orphan reclaimer must never delete.
CELESTO_KEEP_COMPUTER_IDS=
# Orphan reclamation is fail-closed: only computers recorded in the local
# ownership registry are ever considered. off (default) never reclaims
# automatically; dry-run reports candidates; apply deletes them. The CLI
# (scripts/reclaim_orphans.py) defaults to dry-run.
CELESTO_AUTO_RECLAIM=off
CELESTO_RECLAIM_MIN_AGE_S=3600
# Optional path override for the gitignored local ownership registry.
# FLOWSCOUT_OWNERSHIP_REGISTRY=logs/ownership/registry.json
# Live guest Chromium runs headed on the sandbox desktop by default so the
# workflow is observable. Set to 0 for headless; the launcher falls back to
# headless automatically when no X display is available.
FLOWSCOUT_VISIBLE_BROWSER=1

# --- Planner LLM (optional; --planner llm) ---
# Any OpenAI-compatible chat endpoint. Empty means scripted mode only.
LLM_BASE_URL=
LLM_API_KEY=replace-me
LLM_MODEL=

# scripted (deterministic state machine) or llm (LLM proposes each decision
# from a validated candidate set). The --planner flag overrides this.
FLOWSCOUT_PLANNER=scripted

# --- Target fixture ---
# Host fixture used by mock mode and the generated-spec test matrix.
TARGET_BASE_URL=http://127.0.0.1:8090

# --- PostgreSQL run ledger ---
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger
DATABASE_CONNECT_TIMEOUT=3
FLOWSCOUT_LEDGER=postgres
API_PORT=8080

# Docker Compose database values.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# Node test mode: broken for the reproduction spec, fixed for the regression spec.
FLOWSCOUT_TEST_MODE=broken
